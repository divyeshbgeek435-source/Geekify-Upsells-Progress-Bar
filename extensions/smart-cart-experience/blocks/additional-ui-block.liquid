{% comment %}
  Keep guidance in schema-side help text only.
  Do not render editor hint banners in-page, because they visually overlap storefront preview content.
{% endcomment %}

<div
  id="sce-extra-hook-{{ block.id }}"
  class="sce-extra-block-hook"
  {{ block.shopify_attributes }}
  style="min-height: 1px;"
></div>

{{ 'additional-ui.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'additional-ui.js' | asset_url }}"
  data-sce-extra=""
  data-sce-extra-block-id="{{ block.id }}"
  data-sce-extra-hook="sce-extra-hook-{{ block.id }}"
  data-sce-extra-section-id="{{ block.settings.section_id | escape }}"
  data-placement="{{ block.settings.placement | default: 'inline' | escape }}"
  data-api-url="{{ shop.secure_url }}/apps/sce/additional-ui"
  defer
></script>

{% schema %}
{
  "name": "Announcement bar(Section)",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Paste the Section ID from Announcements (Body / Announcement Section). The block only appears when Display is on in the app and this ID matches."
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Required. Must match the section in the app. Display must be on in Announcements or this block stays hidden."
    },
    {
      "type": "select",
      "id": "placement",
      "label": "Placement",
      "default": "inline",
      "options": [
        { "value": "inline", "label": "Inline (inside this section)" },
        { "value": "sticky", "label": "Top of page (fixed)" }
      ]
    }
  ]
}
{% endschema %}
