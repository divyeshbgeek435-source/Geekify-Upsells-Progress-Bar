<div
  id="sce-ab-hook-{{ block.id }}"
  class="sce-announcement-bar-block-hook"
  {{ block.shopify_attributes }}
  style="min-height: 1px;"
>
  <span style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Announcement bar appears here after load</span>
</div>

{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'announcement-bar.js' | asset_url }}"
  data-sce-announcement=""
  data-sce-ab-hook="sce-ab-hook-{{ block.id }}"
  data-placement="sticky"
  data-section-id="{{ block.settings.section_id | escape }}"
  data-api-url="/apps/sce/announcement-bar"
  data-z-index="1000"
  defer
></script>

{% schema %}
{
  "name": "Announcement bar (Header)",
  "target": "section",
  "enabled_on": {
    "templates": ["*"],
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Add this block inside the theme Header section (Theme → Header). Renders inline in the header area. For a sticky bar on every page, enable Geekify storefront under App embeds instead."
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (optional)",
      "info": "Leave blank for the active Header announcement from the app. Paste a Section ID to pin one bar (Display must be on in the app)."
    }
  ]
}
{% endschema %}
