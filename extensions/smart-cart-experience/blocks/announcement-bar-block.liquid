<div
  id="sce-ab-hook-{{ block.id }}"
  class="sce-announcement-bar-block-hook"
  {{ block.shopify_attributes }}
  style="min-height: 1px;"
>
  <span style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Announcement bar appears here after load</span>
</div>

{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'announcement-bar.js' | asset_url }}"
  data-sce-announcement=""
  data-sce-ab-hook="sce-ab-hook-{{ block.id }}"
  data-placement="sticky"
  data-section-id="{{ block.settings.section_id | escape }}"
  data-api-url="{{ block.settings.api_url | default: '/apps/sce/announcement-bar' | escape }}"
  data-z-index="{{ block.settings.z_index }}"
  defer
></script>

{% schema %}
{
  "name": "Announcement bar",
  "target": "section",
  "enabled_on": {
    "templates": ["*"],
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Add this block only in the theme’s Header or Footer section group (Shopify restricts it there). Paste the Section HTML ID from the app (Copy Section ID). Uses the shop’s app proxy at /apps/sce/announcement-bar (same origin as your storefront)."
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Must match Announcement bars in the app (case-insensitive). Examples: sce-ab-… or sce-announcement-…"
    }
  ]
}
{% endschema %}
