<div
  id="sce-fs-mount-{{ block.id }}"
  {{ block.shopify_attributes }}
  style="min-height: 1px;"
></div>

{{ 'free-shipping-progress.css' | asset_url | stylesheet_tag }}
{% liquid
  assign sce_storefront_config = shop.metafields['$app:storefront_config'].value
  if sce_storefront_config == blank
    assign sce_storefront_config = shop.metafields.app.storefront_config.value
  endif
  assign sce_storefront_locked = false
  if sce_storefront_config.storefrontEnabled == false
    assign sce_storefront_locked = true
  endif
%}
{% if sce_storefront_config != blank %}
  <script id="sce-inline-storefront-config" type="application/json">
    {{ sce_storefront_config | json }}
  </script>
{% endif %}
<script src="{{ 'sce-storefront-access.js' | asset_url }}" defer></script>
{% unless sce_storefront_locked %}
<script
  src="{{ 'free-shipping-progress.js' | asset_url }}"
  data-block-id="{{ block.id }}"
  data-fs-mount-root="#sce-fs-mount-{{ block.id }}"
  data-log-url="/apps/sce/cart-access"
  data-dynamic-tier-mode="true"
  data-log-enabled="true"
  data-money-format="{{ shop.money_format | escape }}"
  data-widget-mount-mode="multi"
  defer
></script>
{% endunless %}

{% schema %}
{
  "name": "Progress Bar",
  "target": "section"
}
{% endschema %}
