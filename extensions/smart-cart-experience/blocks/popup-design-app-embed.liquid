{% comment %}
  App embed: loads on every page once enabled in Theme settings → App embeds.
  Use this when page targeting includes product, collection, or cart—the section block
  only runs on templates where that section exists (often homepage only).
{% endcomment %}

<div
  id="sce-popup-embed-hook-{{ block.id }}"
  class="sce-popup-block-hook sce-popup-block-hook--embed"
  {{ block.shopify_attributes }}
  style="display: none;"
></div>

{{ 'popup-design.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'popup-design.js' | asset_url }}"
  data-sce-popup=""
  data-sce-popup-block-id="{{ block.id }}"
  data-sce-popup-hook="sce-popup-embed-hook-{{ block.id }}"
  data-sce-popup-design-id="{{ block.settings.popup_design_id | escape }}"
  data-api-url="{{ shop.secure_url }}/apps/sce/popup-design?popup_design_id={{ block.settings.popup_design_id | url_encode }}"
  defer
></script>

{% schema %}
{
  "name": "Popup design (site-wide)",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Turn this embed ON in Theme → App embeds so the popup script runs on every page. Use the same Popup design ID as in the app. If you also added the section block with the same ID on one template, only one instance will run (no duplicate modals)."
    },
    {
      "type": "text",
      "id": "popup_design_id",
      "label": "Popup design ID",
      "info": "From the app: Popup design page → Design ID."
    }
  ]
}
{% endschema %}
