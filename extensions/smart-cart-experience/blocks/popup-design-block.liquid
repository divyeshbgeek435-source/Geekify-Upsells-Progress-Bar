{% comment %}
  Section block: only loads on templates where this section is included (often the homepage).
  For popups on product, collection, or cart pages, enable **Popup design (site-wide)** under Theme → App embeds
  with the same Design ID, or add this section to those JSON templates.
{% endcomment %}

<div
  id="sce-popup-hook-{{ block.id }}"
  class="sce-popup-block-hook"
  {{ block.shopify_attributes }}
  style="display: none;"
></div>

{{ 'popup-design.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'popup-design.js' | asset_url }}"
  data-sce-popup=""
  data-sce-popup-block-id="{{ block.id }}"
  data-sce-popup-hook="sce-popup-hook-{{ block.id }}"
  data-sce-popup-design-id="{{ block.settings.popup_design_id | escape }}"
  data-api-url="{{ shop.secure_url }}/apps/sce/popup-design?popup_design_id={{ block.settings.popup_design_id | url_encode }}"
  defer
></script>

{% schema %}
{
  "name": "Popup design",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Create popups in the app (Popup design). Paste the Popup design ID. This block only runs where the section exists-for site-wide or page targeting (e.g. products), also enable the app embed “Popup design (site-wide)” under Theme → App embeds."
    },
    {
      "type": "text",
      "id": "popup_design_id",
      "label": "Popup design ID",
      "info": "Must match the ID from the app (Popup design page), same workflow as the Additional UI bar Section ID."
    }
  ]
}
{% endschema %}
