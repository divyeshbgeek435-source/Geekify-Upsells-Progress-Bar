generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnnouncementBody {
  id           String   @id @default(cuid())
  shop         String
  name         String
  sectionId    String
  bodyJson     String   @default("{}")
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  templateJson String   @default("{}")
 
  @@unique([shop, sectionId])
  @@index([shop, updatedAt])
  @@map("announcement_body")
}

model AnnouncementHeader {
  id           String   @id @default(cuid())
  shop         String
  name         String
  active       Boolean  @default(true)
  barType      String
  configJson   String   @default("{}")
  customHtml   String   @default("")
  customLiquid String   @default("")
  customCss    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  templateJson String   @default("{}")

  @@index([shop, updatedAt])
  @@index([shop, active])
  @@map("announcement_headers")
}

model PopupDesign {
  id            String   @id @default(cuid())
  shop          String
  name          String
  popupDesignId String
  configJson    String   @default("{}")
  templateJson  String   @default("{}")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, popupDesignId])
  @@index([shop, updatedAt])
  @@map("popup_design")
}

model Discount {
  id              String    @id @default(cuid())
  shop            String
  kind            String    @default("TIER_DISCOUNT")
  name            String    @default("Default Discount")
  dataJson        String    @default("{}")
  active          Boolean   @default(true)
  scheduleStartAt DateTime?
  scheduleEndAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([shop, kind, name])
  @@index([shop, kind, active])
}

model TierDiscount {
  id              String    @id
  shop            String
  name            String
  active          Boolean   @default(true)
  scheduleStartAt DateTime?
  scheduleEndAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  @@unique([shop, name])
  @@index([shop, active])
}

model TierWidgetSettings {
  id                      String   @id
  shop                    String   @unique
  sequentialMsg1          String   @default("Apply discount to unlock free shipping")
  sequentialMsg2          String   @default("Free shipping unlocked")
  createdAt               DateTime @default(now())
  updatedAt               DateTime
  nameTargetSelectors     String   @default(".cart-drawer__content, .drawer__inner, .drawer__header, form[action='/cart'], .cart__blocks")
  selectorTargets         String   @default(".product__info-container, .cart-drawer__content, .drawer__inner, form[action='/cart'], .cart__blocks")
  sequentialTitle         String   @default("Rewards progress")
  progressBarDesignJson   String   @default("{}")
  sequentialMsg0          String   @default("Unlock Tier 1 to apply your cart discount. Then unlock Tier 2 for free shipping.")
  sequentialHintZero      String   @default("Progress: 0% - unlock Tier 1 to start.")
  sequentialHintMid       String   @default("Progress: 50% - unlock Tier 2 for free shipping.")
  tier1Icon               String   @default("%")
  tier2Icon               String   @default("truck")
  subtotalLabel           String   @default("Current subtotal")
  estimatedShippingLabel  String   @default("Estimated shipping")
  widgetBackgroundColor   String   @default("#ffffff")
  widgetTextColor         String   @default("#111827")
  widgetBorderColor       String   @default("#d1d5db")
  widgetUseCustomColors   Boolean  @default(false)
  tier1LabelText          String   @default("Discount")
  tier2LabelText          String   @default("Free shipping")
  minAmountPrefixText     String   @default("Min.")
  showTierIcons           Boolean  @default(true)
  showTierLabels          Boolean  @default(true)
  showTierMinimums        Boolean  @default(true)
  widgetDynamicConfigJson String   @default("{}")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CartAccessLog {
  id            String   @id @default(cuid())
  shop          String
  itemCount     Int?
  subtotalCents Int?
  currency      String?
  pathname      String?
  source        String?
  createdAt     DateTime @default(now())

  @@index([shop, createdAt])
}

model AnnouncementBar {
  id         String   @id @default(cuid())
  shop       String
  name       String
  barType    String
  configJson String   @default("{}")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, updatedAt])
  @@index([shop, active])
}

model PopupSignup {
  id            String   @id @default(cuid())
  shop          String
  popupDesignId String
  email         String
  firstName     String   @default("")
  createdAt     DateTime @default(now())

  @@unique([shop, popupDesignId, email])
  @@index([shop, popupDesignId])
}

model ShopPlanState {
  shop                            String    @id
  lastKnownPlanId                 String    @default("free")
  pendingDowngradeNotice          Boolean   @default(false)
  /** Set once when the shop starts its only Premium trial; never cleared. */
  premiumTrialConsumedAt          DateTime?
  premiumTrialStartedAt           DateTime?
  /** Set when the trial period ends; never cleared until Premium is purchased. */
  premiumTrialExpiredAt           DateTime?
  /** Mirrored from Shopify billing.check — used on storefront without billing API calls. */
  premiumSubscriptionActive       Boolean   @default(false)
  /** @deprecated Use premiumTrialExpiredAt; kept for legacy rows. */
  pendingPremiumTrialExpiryNotice Boolean   @default(false)
  updatedAt                       DateTime  @updatedAt

  @@map("shop_plan_state")
}
