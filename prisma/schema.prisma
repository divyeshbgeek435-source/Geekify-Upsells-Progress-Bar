// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// SQLite file lives next to this schema (see .gitignore: prisma/dev.sqlite). For PostgreSQL/MySQL, change provider and url.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.sqlite"
}

model CartAccessLog {
  id            String   @id @default(cuid())
  shop          String
  itemCount     Int?
  subtotalCents Int?
  currency      String?
  pathname      String?
  source        String?
  createdAt     DateTime @default(now())

  @@index([shop, createdAt])
}

// https://www.npmjs.com/package/@shopify/shopify-app-session-storage-prisma
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AnnouncementBar {
  id           String   @id @default(cuid())
  shop         String
  name         String
  active       Boolean  @default(true)
  barType      String
  configJson   String   @default("{}")
  /// Storefront markup when using custom mode (fetched by theme script).
  customHtml   String   @default("")
  /// Liquid rendered on the app server when serving the bar (optional).
  customLiquid String   @default("")
  customCss    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop])
}

/// Popup email sign-ups recorded from the storefront (app proxy POST).
model PopupSignup {
  id            String   @id @default(cuid())
  shop          String
  popupDesignId String
  email         String
  firstName     String   @default("")
  createdAt     DateTime @default(now())

  @@unique([shop, popupDesignId, email])
  @@index([shop, popupDesignId])
}

model ThresholdTier {
  id                String   @id @default(cuid())
  shop              String
  discountName      String   @default("Default Discount")
  name              String
  minSubtotal       Float
  rewardType        String
  discountPercent   Float?
  message           String   @default("")
  position          Int      @default(0)
  active            Boolean  @default(true)
  usageCount        Int      @default(0)
  scheduleStartAt   DateTime?
  scheduleEndAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop, discountName, active, position])
}

model TierDiscount {
  id              String   @id @default(cuid())
  shop            String
  name            String
  active          Boolean  @default(true)
  scheduleStartAt DateTime?
  scheduleEndAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop, active])
}

model TierWidgetSettings {
  id                  String   @id @default(cuid())
  shop                String   @unique
  sequentialMsg0      String   @default("Unlock Tier 1 to apply your cart discount. Then unlock Tier 2 for free shipping.")
  sequentialMsg1      String   @default("Apply discount to unlock free shipping")
  sequentialMsg2      String   @default("Free shipping unlocked")
  sequentialHintZero  String   @default("Progress: 0% — unlock Tier 1 to start.")
  sequentialHintMid   String   @default("Progress: 50% — unlock Tier 2 for free shipping.")
  tier1Icon           String   @default("%")
  tier2Icon           String   @default("🚚")
  subtotalLabel       String   @default("Current subtotal")
  estimatedShippingLabel String @default("Estimated shipping")
  widgetBackgroundColor String @default("#ffffff")
  widgetTextColor     String   @default("#111827")
  widgetBorderColor   String   @default("#d1d5db")
  widgetUseCustomColors Boolean @default(false)
  tier1LabelText      String   @default("Discount")
  tier2LabelText      String   @default("Free shipping")
  minAmountPrefixText String   @default("Min.")
  showTierIcons       Boolean  @default(true)
  showTierLabels      Boolean  @default(true)
  showTierMinimums    Boolean  @default(true)
  widgetDynamicConfigJson String @default("{}")
  selectorTargets     String   @default(".product__info-container, .cart-drawer__content, .drawer__inner, form[action='/cart'], .cart__blocks")
  nameTargetSelectors String   @default(".cart-drawer__content, .drawer__inner, .drawer__header, form[action='/cart'], .cart__blocks")
  sequentialTitle     String   @default("Rewards progress")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
